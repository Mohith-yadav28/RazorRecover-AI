# Application Environment
ENV=development
DEBUG=True
PORT=8000

# Backend Configuration
DATABASE_URL=sqlite:///./razorrecover.db
SECRET_KEY=razorrecover-super-secret-development-key-2026

# Razorpay Test Mode Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_MODE=test

# LLM API Provider (OpenAI / Anthropic / Gemini / Fallback)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gpt-4o-mini

# Policy Configuration Rules
AUTO_RETRY_MAX_AMOUNT=5000
AUTO_RETRY_MIN_PROB=0.75
MAX_AUTO_RETRIES=2
HUMAN_APPROVAL_THRESHOLD=50000
MIN_RECOVERY_PROBABILITY=0.60
MAX_CUSTOMER_CONTACTS=3
